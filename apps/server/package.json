{
  "name": "@assistant/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@assistant/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^5.1.0",
    "mongoose": "^8.9.0",
    "zod": "^3.24.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "nanoid": "^5.1.0",
    "dotenv": "^16.4.0",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
