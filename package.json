{
  "name": "assistant",
  "private": true,
  "description": "AI-Native Process Manager — MCP server + React portal",
  "scripts": {
    "dev": "turbo dev",
    "start": "bash start.sh",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:mcp": "pnpm --filter @assistant/server exec vitest run src/mcp/mcp.test.ts",
    "clean": "turbo clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
